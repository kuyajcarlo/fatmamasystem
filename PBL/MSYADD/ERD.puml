@startuml ERD
skinparam roundcorner 5
skinparam linetype ortho
skinparam shadowing false
skinparam hand false
skinparam class {
  BackgroundColor White
  ArrowColor #2688d4
  BorderColor #2688d4
}
hide circle
left to right direction

' Customer flow
entity "USERS" as users {
  * user_id : UUID <<PK>>
  --
  full_name : VARCHAR(100)
  email : VARCHAR(100) <<UNIQUE>>
  password_hash : VARCHAR(255)
  phone_number : VARCHAR(20)
  role : VARCHAR(20)
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "CUSTOMERS" as customers {
  * customer_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  preferred_contact : VARCHAR(50)
  created_at : TIMESTAMP
}

entity "ADDRESSES" as addresses {
  * address_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  street_address : VARCHAR(255)
  city : VARCHAR(100)
  state_province : VARCHAR(100)
  postal_code : VARCHAR(20)
  is_default : BOOLEAN
  created_at : TIMESTAMP
}

entity "INQUIRIES" as inquiries {
  * inquiry_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  name : VARCHAR(100)
  email : VARCHAR(100)
  phone_number : VARCHAR(20)
  message : TEXT
  status : VARCHAR(20)
  created_at : TIMESTAMP
}

' Product + design flow
entity "PRODUCT_CATEGORIES" as product_categories {
  * category_id : UUID <<PK>>
  --
  name : VARCHAR(100)
  description : TEXT
}

entity "PRODUCTS" as products {
  * product_id : UUID <<PK>>
  --
  * category_id : UUID <<FK>>
  sku : VARCHAR(50) <<UNIQUE>>
  name : VARCHAR(100)
  description : TEXT
  base_price : DECIMAL(10,2)
  image_url : TEXT
  is_available : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "CAKE_CUSTOM_DESIGNS" as custom_designs {
  * design_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  size : VARCHAR(20)
  flavor : VARCHAR(50)
  frosting : VARCHAR(50)
  layers : INT
  topper : VARCHAR(100)
  color_code : VARCHAR(20)
  prompt_text : TEXT
  generated_image_url : TEXT
  design_status : VARCHAR(20)
  admin_feedback : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' Order flow
entity "ORDERS" as orders {
  * order_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  * delivery_address_id : UUID <<FK>>
  order_status : VARCHAR(30)
  order_type : VARCHAR(20)
  subtotal_amount : DECIMAL(10,2)
  tax_amount : DECIMAL(10,2)
  discount_amount : DECIMAL(10,2)
  total_amount : DECIMAL(10,2)
  delivery_date : TIMESTAMP
  customer_notes : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "ORDER_ITEMS" as order_items {
  * order_item_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  * product_id : UUID <<FK>>
  design_id : UUID <<FK>> [NULLABLE]
  quantity : INT
  unit_price : DECIMAL(10,2)
  special_instructions : TEXT
  line_total : DECIMAL(10,2)
}

entity "PAYMENTS" as payments {
  * payment_id : UUID <<PK>>
  --
  * order_id : UUID <<FK>>
  provider : VARCHAR(30)
  status : VARCHAR(20)
  amount_paid : DECIMAL(10,2)
  currency : VARCHAR(3)
  transaction_id : VARCHAR(100)
  error_message : TEXT
  created_at : TIMESTAMP
}

' Staff/admin operations
entity "STAFF_MEMBERS" as staff_members {
  * staff_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  employee_number : VARCHAR(50)
  position_title : VARCHAR(100)
  access_level : VARCHAR(30)
  created_at : TIMESTAMP
}

entity "ADMINS" as admins {
  * admin_id : UUID <<PK>>
  --
  * user_id : UUID <<FK>>
  permission_level : VARCHAR(30)
  created_at : TIMESTAMP
}

entity "INVENTORY_ITEMS" as inventory_items {
  * inventory_item_id : UUID <<PK>>
  --
  * product_id : UUID <<FK>>
  item_name : VARCHAR(100)
  supplier_name : VARCHAR(100)
  current_stock : DECIMAL(10,2)
  unit_of_measure : VARCHAR(20)
  cost_per_unit : DECIMAL(10,2)
  reorder_level : DECIMAL(10,2)
  last_restocked_at : TIMESTAMP
}

entity "INVENTORY_LOGS" as inventory_logs {
  * log_id : UUID <<PK>>
  --
  * inventory_item_id : UUID <<FK>>
  * recorded_by_user_id : UUID <<FK>>
  change_qty : DECIMAL(10,2)
  reason : VARCHAR(50)
  created_at : TIMESTAMP
}

' Use-case based relationships
users ||--o| customers : "profile"
users ||--o{ addresses : "has"
users ||--o{ orders : "places"
users ||--o{ custom_designs : "creates"
users ||--o{ inquiries : "sends"
users ||--o| staff_members : "profile"
users ||--o| admins : "profile"

staff_members ||--o{ custom_designs : "approves"
staff_members ||--o{ inquiries : "handles"
admins ||--o{ inventory_logs : "reviews"

product_categories ||--o{ products : "contains"
products ||--o{ inventory_items : "stocked as"
products ||--o{ order_items : "included in"
inventory_items ||--o{ inventory_logs : "tracked by"
custom_designs ||--o| order_items : "attached to"

orders }o--|| addresses : "delivered to"
orders ||--|{ order_items : "contains"
orders ||--o| payments : "paid via"

@enduml
