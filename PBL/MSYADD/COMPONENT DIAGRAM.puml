@startuml ComponentDiagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(customerApp, "Customer Web App", "React / Next.js")
Container(adminApp, "Admin & POS Portal", "React / Next.js")
ContainerDb(database, "PostgreSQL Database", "Supabase")
System_Ext(openai, "OpenAI API", "External API")

Container_Boundary(api, "Backend API (Nest.js)") {
    Component(authCtrl, "Auth Controller", "Nest.js Controller", "Handles registration and authentication endpoints.")
    Component(authSvc, "Auth Service", "Nest.js Service", "Validates JWT tokens and user roles.")
    
    Component(orderCtrl, "Orders Controller", "Nest.js Controller", "Manages checkout, POS orders, and order status updates.")
    Component(orderSvc, "Orders Service", "Nest.js Service", "Handles order status updates and stock reduction.")
    
    Component(aiCtrl, "AI Cake Controller", "Nest.js Controller", "Receives prompt requests for generative cake designs.")
    Component(aiSvc, "AI Cake Service", "Nest.js Service", "Formats prompts and calls OpenAI DALL-E API.")
    
    Component(chatCtrl, "Chatbot Controller", "Nest.js Controller", "Handles customer chat inquiries.")
    Component(chatSvc, "Chatbot Service", "Nest.js Service", "Processes NLP context and response routing.")
    
    Component(invCtrl, "Inventory Controller", "Nest.js Controller", "Manages raw material stock levels.")
    Component(invSvc, "Inventory Service", "Nest.js Service", "Tracks inventory logs and triggers reorder alerts.")
    
    Component(orm, "Database Access Layer", "Prisma / Supabase Client", "Abstracts SQL queries to PostgreSQL database.")
}

Rel(customerApp, authCtrl,"POST /auth/login")
Rel(customerApp, orderCtrl,"POST /orders")
Rel(customerApp, aiCtrl,"POST /ai/generate-cake")
Rel(customerApp, chatCtrl,"POST /chat")

Rel(adminApp, orderCtrl,"GET /orders, PATCH /orders/:id")
Rel(adminApp, invCtrl,"GET/POST /inventory")

Rel(authCtrl, authSvc,"Uses")
Rel(orderCtrl, orderSvc,"Uses")
Rel(aiCtrl, aiSvc,"Uses")
Rel(chatCtrl, chatSvc,"Uses")
Rel(invCtrl, invSvc,"Uses")

Rel(orderSvc, invSvc, "Triggers stock deduct")
Rel(aiSvc, openai, "Generates Image via DALL-E", "HTTPS")
Rel(chatSvc, openai, "Queries NLP Engine", "HTTPS")

Rel(authSvc, orm, "Reads/Writes User Data")
Rel(orderSvc, orm, "Reads/Writes Order Data")
Rel(invSvc, orm, "Reads/Writes Stock Data")
Rel(orm, database, "Executes SQL queries")

@enduml
